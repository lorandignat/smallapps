{
  "$schema": "https://opencode.ai/config.json",

  // All four agents run on the free DeepSeek model.
  "model": "opencode/tidepool-alpha-free",
  // To revert when DeepSeek quota resets: change to "opencode/deepseek-v4.1-flash-free"
  // and restore `model: opencode/deepseek-v4.1-flash-free#high` in the four agent
  // files under .opencode/agents/.

  // The only agent the human talks to.
  "default_agent": "ba",

  // Workspace-level documents every session sees, including subagents.
  "instructions": ["docs/PROCESS.md", "docs/CONVENTIONS.md"],

  // Last matching rule wins. Agent files refine these further.
  "permissions": [
    // Containment: nothing outside the workspace.
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "read", "resource": "/**", "effect": "deny" },
    { "action": "read", "resource": "/homedir/agent/opencode/apps/**", "effect": "allow" },
    { "action": "edit", "resource": "/**", "effect": "deny" },
    { "action": "edit", "resource": "/homedir/agent/opencode/apps/**", "effect": "allow" },

    // No privilege escalation, no publishing, no host damage.
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "su *", "effect": "deny" },
    { "action": "shell", "resource": "git push*", "effect": "allow" },
    { "action": "shell", "resource": "git remote*", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf /*", "effect": "deny" }
  ]
}
